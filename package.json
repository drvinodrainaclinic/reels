{
  "name": "reel-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Reel out/reel.mp4",
    "script": "node scripts/generate-script.mjs",
    "voice": "node scripts/tts.mjs",
    "ui": "node server.mjs",
    "start": "node server.mjs",
    "make": "npm run script -- \"$TOPIC\" && npm run voice && npm run render"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@remotion/cli": "4.0.547",
    "@remotion/media-utils": "4.0.547",
    "express": "^4.22.3",
    "multer": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.547"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.5.0"
  }
}
